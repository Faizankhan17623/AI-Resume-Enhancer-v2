# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- Core (required) ---
PORT=4000
NODE_ENV=development
MONGO_DB_URL=mongodb+srv://user:password@cluster.mongodb.net/
JWT_PRIVATE_KEY=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:5174

# Production only: Production requires a MongoDB replica set (Atlas provides one by default).
# Set true only if you knowingly accept non-atomic payment/credit writes on a standalone Mongo.
# ALLOW_NON_TRANSACTIONAL_WRITES=false

# --- AI (Groq) ---
GROQ_API_KEY=your-groq-api-key
# Optional per-plan model overrides — see Backend/utils/AiModel.js for defaults
# GROQ_MODEL_BASIC=openai/gpt-oss-20b
# GROQ_MODEL_PRO=openai/gpt-oss-20b
# GROQ_MODEL_PROMAX=openai/gpt-oss-120b

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- File uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- Email ---
# Direct SMTP (used if MAIL_RELAY_* below is not set)
MAIL_HOST=smtp.gmail.com
MAIL_USER=you@example.com
MAIL_PASS=your-gmail-app-password
# Production relay (Render/EC2 may block outbound SMTP — see utils/Nodemailer.js). Leave unset to
# use direct SMTP above instead.
# MAIL_RELAY_URL=https://your-vercel-app.vercel.app/api/send-mail
# MAIL_RELAY_SECRET=shared-secret-with-the-relay-function
ADMIN_ALERT_EMAIL=you@example.com

# --- OAuth (sign-in with Google/GitHub) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
# Present in some environments but currently unreferenced in code — Facebook/LinkedIn sign-in was
# never fully wired up. Safe to leave unset.
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_CALLBACK_URL=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_CALLBACK_URL=

# --- Other integrations ---
TAVILY_API_KEY=your-tavily-api-key
IPIFY_API_KEY=your-ipify-api-key

# --- Web Push notifications ---
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:you@example.com

# --- Logging ---
# LOG_LEVEL=info
